<?xml version="1.0" encoding="utf-8"?>
<!--
    Spoon Browser — Network Security Config

    Default policy: cleartext (http://) traffic is FORBIDDEN everywhere.
    Only the domains listed below may use http://.

    Why whitelist anything?
    Home routers almost universally serve their admin panels over plain
    HTTP on the LAN. Blocking http:// entirely would break the "I need
    to log into my router" use case completely. The whitelist below
    covers the router brands and default-gateway IPs we see most often.

    IMPORTANT: the list below MUST stay in sync with CleartextPolicy.java.
    The XML is what Android actually enforces; the Java class lets app
    code reason about the same list without duplicating strings.

    Constraints
    Network Security Config is compiled into the APK and CANNOT be
    modified at runtime. If your router is at an IP that is not listed
    here, you must:
        1. Add the IP to this file
        2. Add the same IP to CleartextPolicy.java
        3. Rebuild
    A user-editable router-host list is tracked as Batch D.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />

    <domain-config cleartextTrafficPermitted="true">

        <!-- Loopback -->
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">::1</domain>

        <!-- Android emulator host -->
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">10.0.2.3</domain>

        <!-- Router admin hostnames (brand aliases) -->
        <domain includeSubdomains="true">tplinkwifi.net</domain>
        <domain includeSubdomains="true">tplinklogin.net</domain>
        <domain includeSubdomains="true">routerlogin.net</domain>
        <domain includeSubdomains="true">routerlogin.com</domain>
        <domain includeSubdomains="true">tendawifi.com</domain>
        <domain includeSubdomains="true">asusrouter.com</domain>
        <domain includeSubdomains="true">mwlogin.net</domain>
        <domain includeSubdomains="true">pi.hole</domain>

        <!-- mDNS (.local hostnames) -->
        <domain includeSubdomains="true">local</domain>

        <!-- Default gateway IPs: 10.x range -->
        <domain includeSubdomains="false">10.0.0.1</domain>
        <domain includeSubdomains="false">10.0.0.138</domain>
        <domain includeSubdomains="false">10.0.1.1</domain>
        <domain includeSubdomains="false">10.1.1.1</domain>
        <domain includeSubdomains="false">10.1.10.1</domain>

        <!-- Default gateway IPs: 172.16.x range -->
        <domain includeSubdomains="false">172.16.0.1</domain>

        <!-- Default gateway IPs: 192.168.x range (most common defaults) -->
        <domain includeSubdomains="false">192.168.0.1</domain>
        <domain includeSubdomains="false">192.168.1.1</domain>
        <domain includeSubdomains="false">192.168.1.254</domain>
        <domain includeSubdomains="false">192.168.2.1</domain>
        <domain includeSubdomains="false">192.168.4.1</domain>
        <domain includeSubdomains="false">192.168.8.1</domain>
        <domain includeSubdomains="false">192.168.50.1</domain>
        <domain includeSubdomains="false">192.168.100.1</domain>

    </domain-config>
</network-security-config>
