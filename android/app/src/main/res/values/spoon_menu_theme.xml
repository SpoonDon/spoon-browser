<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Custom theme for the top-right main menu dialog.

      Inherits from Theme.Material.Dialog but zeroes the window minimum
      width attributes. The platform dialog theme sets
      windowMinWidthMajor=65% / windowMinWidthMinor=55%, which forces
      the window to be at least 55% of the screen width even when the
      content only needs 30%. Result: massive dead gray space on the
      right side of every row. Overriding them to 0dp lets the dialog
      truly wrap the widest row.
    -->
    <style name="SpoonMenuDialog" parent="android:Theme.Material.Dialog">
        <item name="android:windowMinWidthMajor">0dip</item>
        <item name="android:windowMinWidthMinor">0dip</item>
        <item name="android:windowFixedWidthMajor">0dip</item>
        <item name="android:windowFixedWidthMinor">0dip</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:colorBackgroundFloating">@android:color/transparent</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowFrame">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>
</resources>
